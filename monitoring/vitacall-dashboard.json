{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Request-latency p50 / p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "vitacall_latency_p50_ms", "legendFormat": "p50" },
        { "expr": "vitacall_latency_p95_ms", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Requests totaal / errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "vitacall_requests_total", "legendFormat": "total" },
        { "expr": "vitacall_requests_errors_total", "legendFormat": "errors" }
      ]
    },
    {
      "title": "Output-drift score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "vitacall_drift_score" } ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "orange", "value": 0.2 },
            { "color": "red", "value": 0.3 }
          ] }
        }
      }
    },
    {
      "title": "Gem. voorspel-confidence",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "vitacall_avg_confidence" } ]
    },
    {
      "title": "Uptime (s)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "vitacall_uptime_seconds" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["vitacall", "mlops"],
  "title": "VitaCall — model & systeem-monitoring",
  "uid": "vitacall",
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" }
}
